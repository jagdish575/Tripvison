# ---------------------------------------------------------------- TripMission configuration
# Copy to .env and fill in. Never commit .env — and never put real keys or passwords in this file.

# Live travel data (required unless DEMO_MODE=true) — https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# true = every mission uses the labelled demo dataset instead of live searches (no Google sign-in needed
# to explore it; "Continue in Demo Mode" works either way)
DEMO_MODE=false

# true = show developer diagnostics in the UI/API: request counts, timings, cache hits, raw provider errors.
# Keep false for real users.
DEBUG_MODE=false

# ---------------------------------------------------------------- authentication
# Google Identity Services OAuth client ID (Web application) — see README "Google sign-in setup".
# The client ID is public by design and is served to the browser by /api/v1/auth/config.
GOOGLE_CLIENT_ID=
# Only needed for a server-side authorization-code flow. The ID-token flow used here does not need it.
# Never expose it to the frontend.
GOOGLE_CLIENT_SECRET=
# Long random string used to sign session cookies (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))").
# Empty = a random key per server start (sessions end on restart) — fine for local dev only.
SESSION_SECRET=
SESSION_TTL_HOURS=336
# Empty = auto (Secure cookies when APP_BASE_URL / FRONTEND_URL is https)
SESSION_COOKIE_SECURE=
# Missions require a signed-in (Google or demo) session
AUTH_REQUIRED=true
# Offer "Continue in Demo Mode" (no Google account needed — great for judges)
DEMO_LOGIN_ENABLED=true

# ---------------------------------------------------------------- route intelligence
# An airport further than this (road minutes from the venue) is never used for flight + transfer journeys
MAX_PRACTICAL_AIRPORT_TRANSFER_MINUTES=180
# Flight journeys whose airport transfer exceeds this are marked LOW PRACTICALITY
LOW_PRACTICALITY_AIRPORT_TRANSFER_MINUTES=90
# Trips shorter than this (straight-line km) skip flight searches entirely
MIN_FLIGHT_DISTANCE_KM=200
# Arrive this early for a domestic flight (part of door-to-door time)
AIRPORT_CHECKIN_MINUTES=75
# Optional lookups (local places, reviews) never block a mission longer than this
OPTIONAL_TIMEOUT_SECONDS=8

# ---------------------------------------------------------------- storage
# Database. Empty = SQLite file in backend/.
# Local backend + Docker Postgres (run: docker compose up -d postgres redis):
# DATABASE_URL=postgresql+psycopg://tripvision:tripvision@localhost:55432/tripvision
DATABASE_URL=

# Optional Redis cache for SerpApi responses (empty = database cache)
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ---------------------------------------------------------------- AI (optional)
# Optional AI for the "Why this journey?" text (rule-based text without it)
# AI_PROVIDER = euri (OpenAI-compatible, euron.one) | anthropic
AI_PROVIDER=euri
AI_API_KEY=
# Model names change often; use one listed in your provider's documentation.
AI_MODEL=gpt-5.4-mini
# Optional fallback model, tried if AI_MODEL fails
AI_MODEL_FAST=gpt-6-luna
# Endpoint for euri (any OpenAI-compatible base URL works)
AI_BASE_URL=https://api.euron.one/api/v1/euri

# ---------------------------------------------------------------- email (optional)
# Trip summary, reminders, change alerts. Without a provider, emails are generated as in-app previews.
# EMAIL_PROVIDER = auto | smtp | resend | preview
EMAIL_PROVIDER=auto
EMAIL_FROM=TripMission <no-reply@tripmission.app>
# SMTP (e.g. Gmail with an app password: smtp.gmail.com, 587, your address, the 16-char app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=you@example.com
SMTP_USE_TLS=true
# or Resend (https://resend.com) — verified sender domain required
RESEND_API_KEY=
# Public URL used in "View my journey" links (defaults to the first FRONTEND_URL)
APP_BASE_URL=

# Comma-separated CORS origins allowed to call the API (with credentials)
FRONTEND_URL=http://localhost:5173

# Optional JSON override of the default scoring weights, e.g. {"arrival":0.4,"budget":0.2}
SCORING_WEIGHTS=

LOG_LEVEL=INFO
